+// Private research build only. The existing debug server reads this buffer without consuming it.
+const enabled = process.env.OMP_RESEARCH_INPUT_TRACE === "1";
+const ids = new WeakMap<object, number>();
+let nextId = 1;
+export type ResearchEventKind = "received" | "sequence" | "win32" | "normalized" | "focus" | "custom" | "editor" | "state" | "assist-return" | "completion-applied" | "completion-return" | "completion-stale-return" | "navigation-return" | "paste-return" | "alt-return" | "submit-entered" | "submit-disabled" | "unrelated-newline" | "editor-return" | "dictation-return" | "callback-dispatch" | "gate" | "callback-assigned" | "callback-entry" | "login" | "startup";
+type Event = { seq: number; kind: ResearchEventKind; id: number; a: number; b: number; c: number; d: number };
+const events: Event[] = [];
+let bytes = 0;
+let dropped = 0;
+
+export function researchIdentity(value: object): number {
+	if (!enabled) return 0;
+	let id = ids.get(value);
+	if (id === undefined) { id = nextId++; ids.set(value, id); }
+	return id;
+}
+
+export function researchEvent(kind: ResearchEventKind, id = 0, a = 0, b = 0, c = 0, d = 0): void {
+	if (!enabled) return;
+	const event = { seq: events.length + 1, kind, id, a, b, c, d };
+	const size = Buffer.byteLength(JSON.stringify(event)) + 1;
+	// Reserve 512 bytes for the fixed debug-response envelope and overflow counters.
+	if (events.length === 256 || bytes + size > 32768 - 512) { dropped = Math.min(dropped + 1, Number.MAX_SAFE_INTEGER); return; }
+	events.push(event);
+	bytes += size;
+}
+
+if (enabled) {
+  (globalThis as typeof globalThis & { [key: symbol]: unknown })[Symbol.for("cruxomni.windowsResearch.trace.v1")] = (marker: unknown) => {
+    if (typeof marker === "number" && Number.isInteger(marker) && ((marker >= 19 && marker <= 39) || (marker >= 41 && marker <= 44))) researchEvent("startup", 0, marker);
+  };
+}
+
+export function researchRead(cursor: number): { available: false } | { available: true; pid: number; events: readonly Event[]; cursor: number; overflow: boolean; dropped: number; bytes: number } {
+	if (!enabled) return { available: false };
+	return { available: true, pid: process.pid, events: events.filter(event => event.seq > cursor), cursor: events.length, overflow: dropped > 0, dropped, bytes };
+}
+
+// Record only control-byte categories, never the byte sequence or arbitrary text length.
+export function researchReceived(stage: "received" | "sequence", data: string): void {
+	if (!enabled) return;
+	const category = (data.includes("\r") ? 1 : 0) | (data.includes("\n") ? 2 : 0) | (data.includes("\x1b") ? 4 : 0);
+	if (category) researchEvent(stage, 0, category);
+}
+
+// Inspect only already-parsed canonical values and categorize; never retain input.
+export function researchKey(stage: "custom" | "editor", id: number, data: string, canonical?: string): void {
+	if (!enabled) return;
+	const key = canonical === "enter" ? 1 : canonical?.endsWith("+enter") ? 2 : 0;
+	const raw = data === "\r" ? 1 : data === "\n" ? 2 : 0;
+	if (!key && !raw) return;
+	const modifiers = canonical === undefined ? 0 : (canonical.includes("shift+") ? 1 : 0) | (canonical.includes("alt+") ? 2 : 0) | (canonical.includes("ctrl+") ? 4 : 0) | (canonical.includes("meta+") ? 8 : 0) | (canonical.includes("super+") ? 16 : 0);
+	researchEvent(stage, id, raw, key, modifiers);
+}
