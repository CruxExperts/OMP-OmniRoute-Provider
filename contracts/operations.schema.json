{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cruxexperts.example/cruxomni-omp-client/contracts/operations.schema.json",
  "title": "Versioned OmniRoute operation contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "recordKind", "release", "generatedFrom", "sourceContext", "counts", "operations"],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": 2},
    "recordKind": {"const": "omniroute-operation-contract"},
    "release": {"$ref": "#/$defs/release"},
    "generatedFrom": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest", "manifestSha256", "eligibility", "eligibilitySha256", "sourceCorpusFileCount", "authority"],
      "properties": {
        "manifest": {"const": "provenance/route-sources.json"},
        "manifestSha256": {"$ref": "#/$defs/sha256"},
        "eligibility": {"const": "contracts/release-eligibility.json"},
        "eligibilitySha256": {"$ref": "#/$defs/sha256"},
        "sourceCorpusFileCount": {"type": "integer", "minimum": 1},
        "authority": {"type": "string", "minLength": 1}
      }
    },
    "sourceContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frameworkContextSha256", "routeImportDigests"],
      "properties": {
        "frameworkContextSha256": {"$ref": "#/$defs/sha256"},
        "routeImportDigests": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/sha256"}}
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["routeFiles", "sourceOperations", "openapiPaths", "openapiOperations", "documentedOperations", "unmatchedSpecificationMethods", "invokableOperations", "nonInvokableOperations", "unqualifiedOperations", "methodCounts"],
      "properties": {
        "routeFiles": {"type": "integer", "minimum": 1},
        "sourceOperations": {"type": "integer", "minimum": 1},
        "openapiPaths": {"type": "integer", "minimum": 0},
        "openapiOperations": {"type": "integer", "minimum": 0},
        "documentedOperations": {"type": "integer", "minimum": 0},
        "unmatchedSpecificationMethods": {"type": "integer", "minimum": 0},
        "invokableOperations": {"type": "integer", "minimum": 0},
        "nonInvokableOperations": {"type": "integer", "minimum": 0},
        "unqualifiedOperations": {"type": "integer", "minimum": 0},
        "methodCounts": {"$ref": "#/$defs/methodCounts"}
      }
    },
    "operations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/operation"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "gitSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "commit", "releaseId", "latestSelectorUrl", "latestApiUrl", "releaseUrl", "selectorKind", "latestRedirectTarget", "selectorCheckedAt", "publishedAt", "readmeNpmBadgeIsNotSelector"],
      "properties": {
        "repository": {"const": "diegosouzapw/OmniRoute"},
        "tag": {"const": "v3.8.52"},
        "commit": {"const": "ad6f33f66bda34eba98645d3bfdabbde294bc843"},
        "releaseId": {"type": "integer", "minimum": 1},
        "latestSelectorUrl": {"type": "string", "format": "uri"},
        "latestApiUrl": {"type": "string", "format": "uri"},
        "releaseUrl": {"const": "https://github.com/diegosouzapw/OmniRoute/releases/tag/v3.8.52"},
        "selectorKind": {"const": "github-latest-release"},
        "latestRedirectTarget": {"const": "v3.8.52"},
        "selectorCheckedAt": {"type": "string", "format": "date-time"},
        "publishedAt": {"type": "string", "format": "date-time"},
        "readmeNpmBadgeIsNotSelector": {"const": true}
      }
    },
    "methodCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["DELETE", "GET", "HEAD", "OPTIONS", "PATCH", "POST", "PUT"],
      "properties": {
        "DELETE": {"type": "integer", "minimum": 0},
        "GET": {"type": "integer", "minimum": 0},
        "HEAD": {"type": "integer", "minimum": 0},
        "OPTIONS": {"type": "integer", "minimum": 0},
        "PATCH": {"type": "integer", "minimum": 0},
        "POST": {"type": "integer", "minimum": 0},
        "PUT": {"type": "integer", "minimum": 0}
      }
    },
    "jsonSchema": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [{
        "if": {"required": ["x-key-role"]},
        "then": {
          "required": ["type", "additionalProperties"],
          "properties": {"type": {"const": "object"}, "additionalProperties": {"type": "object"}}
        }
      }],
      "properties": {
        "$ref": {"type": "string"},
        "type": {"oneOf": [{"type": "string"}, {"type": "array", "items": {"type": "string"}}]},
        "properties": {"type": "object", "additionalProperties": {"$ref": "#/$defs/jsonSchema"}},
        "required": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "additionalProperties": {"oneOf": [{"type": "boolean"}, {"$ref": "#/$defs/jsonSchema"}]},
        "x-key-role": {"const": "identifier"},
        "items": {"$ref": "#/$defs/jsonSchema"},
        "enum": {"type": "array"},
        "const": {},
        "oneOf": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/jsonSchema"}},
        "anyOf": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/jsonSchema"}},
        "allOf": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/jsonSchema"}},
        "pattern": {"type": "string"},
        "format": {"enum": ["binary", "byte", "date-time", "uri", "uuid"]},
        "minLength": {"type": "integer", "minimum": 0},
        "maxLength": {"type": "integer", "minimum": 0},
        "minimum": {"type": "number"},
        "maximum": {"type": "number"},
        "exclusiveMinimum": {"type": "number"},
        "exclusiveMaximum": {"type": "number"},
        "minItems": {"type": "integer", "minimum": 0},
        "maxItems": {"type": "integer", "minimum": 0},
        "minProperties": {"type": "integer", "minimum": 0},
        "maxProperties": {"type": "integer", "minimum": 0},
        "default": {},
        "description": {"type": "string"},
        "title": {"type": "string"},
        "example": {},
        "examples": {"type": "array"},
        "readOnly": {"type": "boolean"},
        "writeOnly": {"type": "boolean"}
      }
    },
    "contentVariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mediaType", "schema"],
      "properties": {
        "mediaType": {"type": "string", "minLength": 1},
        "schema": {"oneOf": [{"$ref": "#/$defs/jsonSchema"}, {"type": "null"}]},
        "sourceFile": {"type": "string", "pattern": "^(?:src|packages)/.+\\.tsx?$"}
      }
    },
    "body": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["required", "mediaType", "schema", "contentVariants"],
      "properties": {
        "required": {"type": "boolean"},
        "mediaType": {"type": ["string", "null"]},
        "schema": {"oneOf": [{"$ref": "#/$defs/jsonSchema"}, {"type": "null"}]},
        "contentVariants": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/contentVariant"}}
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "in", "required", "style", "explode", "allowReserved", "schema", "inputAllowed"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "in": {"enum": ["path", "query", "header", "cookie"]},
        "required": {"type": "boolean"},
        "style": {"type": "string", "minLength": 1},
        "explode": {"type": "boolean"},
        "allowReserved": {"type": "boolean"},
        "schema": {"$ref": "#/$defs/jsonSchema"},
        "inputAllowed": {"type": "boolean"},
        "sourceFile": {"type": "string", "pattern": "^src/app/.+/route\\.ts$"}
      }
    },
    "pathParameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "specName", "serialization", "required"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "specName": {"type": "string", "minLength": 1},
        "serialization": {"enum": ["simple", "label", "matrix", "catch-all-segments"]},
        "required": {"type": "boolean"},
        "style": {"type": "string"},
        "explode": {"type": "boolean"}
      }
    },
    "sourceNormalization": {
      "enum": [
        "omniroute-v3.8.52.provider-interception-rules",
        "omniroute-v3.8.52.provider-param-filters",
        "omniroute-v3.8.52.model-capability-overrides.patch",
        "omniroute-v3.8.52.combos.create",
        "omniroute-v3.8.52.combos.update",
        "omniroute-v3.8.52.combos.duplicate",
        "omniroute-v3.8.52.combos.reorder",
        "omniroute-v3.8.52.combos.test",
        "omniroute-v3.8.52.combos.list-query"
      ]
    },
    "sourceStateView": {
      "enum": ["omniroute-v3.8.52.provider-interception-rules", "omniroute-v3.8.52.provider-param-filters"]
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pathSchema", "querySchema", "pathParameters", "parameters", "body", "specificationDocumented"],
      "properties": {
        "pathSchema": {"$ref": "#/$defs/jsonSchema"},
        "querySchema": {"$ref": "#/$defs/jsonSchema"},
        "pathParameters": {"type": "array", "items": {"$ref": "#/$defs/pathParameter"}},
        "parameters": {"type": "array", "items": {"$ref": "#/$defs/parameter"}},
        "body": {"$ref": "#/$defs/body"},
        "specificationDocumented": {"type": "boolean"},
        "normalizations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["section", "path", "kind"],
            "properties": {
              "section": {"enum": ["path", "query", "body"]},
              "path": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
              "kind": {"enum": ["trim-string", "trim-string-array"]}
            }
          }
        },
        "sourceValidator": {
          "enum": [
            "omniroute-v3.8.52.provider-create",
            "omniroute-v3.8.52.fallback-chains.register",
            "omniroute-v3.8.52.fallback-chains.remove",
            "omniroute-v3.8.52.combos.create",
            "omniroute-v3.8.52.combos.update",
            "omniroute-v3.8.52.combos.duplicate",
            "omniroute-v3.8.52.combos.reorder",
            "omniroute-v3.8.52.combos.test"
          ]
        },
        "sourceNormalizer": {"$ref": "#/$defs/sourceNormalization"}
      }
    },
    "responseHeader": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "schema"],
      "properties": {"required": {"type": "boolean"}, "schema": {"oneOf": [{"$ref": "#/$defs/jsonSchema"}, {"type": "null"}]}}
    },
    "responseVariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statusCode", "content", "headers"],
      "properties": {
        "statusCode": {"type": "string", "minLength": 1},
        "content": {"type": "array", "items": {"$ref": "#/$defs/contentVariant"}},
        "headers": {"type": "object", "additionalProperties": {"$ref": "#/$defs/responseHeader"}},
        "sourceFiles": {"type": "array", "items": {"type": "string", "pattern": "^(?:src|packages)/.+\\.tsx?$"}, "uniqueItems": true}
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statusCodes", "mediaType", "schema", "variants"],
      "properties": {
        "statusCodes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "mediaType": {"type": ["string", "null"]},
        "schema": {"oneOf": [{"$ref": "#/$defs/jsonSchema"}, {"type": "null"}]},
        "variants": {"type": "array", "items": {"$ref": "#/$defs/responseVariant"}}
      }
    },
    "fieldMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "source"],
      "properties": {
        "target": {"type": "object", "additionalProperties": false, "required": ["section", "field"], "properties": {"section": {"enum": ["path", "query"]}, "field": {"type": "string", "minLength": 1}}},
        "source": {"type": "object", "additionalProperties": false, "required": ["section", "path"], "properties": {"section": {"enum": ["path", "query", "body", "result"]}, "path": {"type": "array", "items": {"type": "string"}}}}
      }
    },
    "projectedField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "path": {"type": "array", "items": {"type": "string"}},
        "sourceView": {"$ref": "#/$defs/sourceStateView"}
      }
    },
    "reconciliation": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["targetRead", "reconcile"],
      "properties": {
        "targetRead": {
          "type": "object",
          "additionalProperties": false,
          "required": ["operationId", "inputs", "snapshot"],
          "properties": {
            "operationId": {"type": "string", "minLength": 1},
            "sourceView": {
              "enum": [
                "omniroute-v3.8.52.fallback-chains.reconciliation",
                "omniroute-v3.8.52.combos.create-reconcile",
                "omniroute-v3.8.52.combos.duplicate-reconcile",
                "omniroute-v3.8.52.combos.item-update-reconcile",
                "omniroute-v3.8.52.combos.item-delete-reconcile",
                "omniroute-v3.8.52.combos.reorder-reconcile",
                "omniroute-v3.8.52.combos.metrics-reset-reconcile"
              ]
            },
            "inputs": {"type": "array", "items": {"$ref": "#/$defs/fieldMapping"}},
            "snapshot": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "identity", "state"],
              "properties": {
                "kind": {"enum": ["resource", "collection", "action"]},
                "identity": {"type": "array", "items": {"$ref": "#/$defs/projectedField"}},
                "state": {"type": "array", "items": {"$ref": "#/$defs/projectedField"}},
                "collectionPath": {"type": "array", "items": {"type": "string", "minLength": 1}},
                "selection": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["input", "rowPath"],
                  "properties": {
                    "input": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["section", "path"],
                      "properties": {
                        "section": {"enum": ["path", "query", "body"]},
                        "path": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
                      }
                    },
                    "rowPath": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
                  }
                }
              }
            }
          }
        },
        "reconcile": {
          "type": "object",
          "additionalProperties": false,
          "required": ["operationId", "inputs", "outcome"],
          "properties": {
            "operationId": {"type": "string", "minLength": 1},
            "inputs": {"type": "array", "items": {"$ref": "#/$defs/fieldMapping"}},
            "outcome": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "identityFields", "stateFields"],
              "properties": {
                "kind": {"enum": ["exists", "absent", "matches", "upsert"]},
                "identityFields": {"type": "array", "items": {"type": "string"}},
                "stateFields": {"type": "array", "items": {"type": "string"}},
                "expectedFromInput": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["name", "source"],
                    "properties": {
                      "name": {"type": "string", "minLength": 1},
                      "sourceView": {"$ref": "#/$defs/sourceStateView"},
                      "source": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["section", "path"],
                        "properties": {
                          "section": {"enum": ["path", "query", "body"]},
                          "path": {"type": "array", "items": {"type": "string", "minLength": 1}}
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "securityAlternative": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "scopes", "type", "scheme", "in", "parameterName", "unresolved"],
      "properties": {
