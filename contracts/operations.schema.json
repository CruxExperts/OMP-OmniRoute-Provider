                "additionalProperties": false,
                "required": ["kind", "loopbackOnly"],
                "properties": {"kind": {"const": "trusted-local"}, "loopbackOnly": {"const": true}}
              }
            }
          }
        }
      ]
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operationId", "method", "pathTemplate", "request", "response", "mediaType", "auth", "secrets", "sideEffect", "pagination", "streaming", "confirmation", "retry", "source", "specification", "reconciliation", "coverage"],
      "properties": {
        "operationId": {"type": "string", "minLength": 1},
        "method": {"enum": ["DELETE", "GET", "HEAD", "OPTIONS", "PATCH", "POST", "PUT"]},
        "pathTemplate": {"type": "string", "pattern": "^/(?:[A-Za-z0-9._~-]+|\\{[A-Za-z0-9._~-]+\\})(?:/(?:[A-Za-z0-9._~-]+|\\{[A-Za-z0-9._~-]+\\}))*$"},
