        "response": {"$ref": "#/$defs/response"},
        "mediaType": {"type": "object", "additionalProperties": false, "required": ["request", "response"], "properties": {"request": {"type": ["string", "null"]}, "response": {"type": ["string", "null"]}}},
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "required": ["domain", "specificationAlternatives", "sourcePolicy"],
          "properties": {
            "domain": {"enum": ["public", "runtime", "metadata", "management", "local", "unknown"]},
            "specificationAlternatives": {"type": "array", "items": {"type": "array", "items": {"$ref": "#/$defs/securityAlternative"}}},
            "sourcePolicy": {"$ref": "#/$defs/sourceAuthorizationPolicy"}
