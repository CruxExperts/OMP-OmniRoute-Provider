        "scopes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "type": {"type": ["string", "null"]},
        "scheme": {"type": ["string", "null"]},
        "in": {"type": ["string", "null"]},
        "parameterName": {"type": ["string", "null"]},
        "unresolved": {"type": "boolean"}
      }
    },
    "managementAuthorizationAlternative": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "anyOf"],
          "properties": {
            "kind": {"const": "management-api-key"},
            "anyOf": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["manage", "admin"]}}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {"kind": {"const": "dashboard-session"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "when"],
          "properties": {
            "kind": {"const": "auth-disabled"},
            "when": {"const": "central-and-handler-auth-not-required"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "minimumScope"],
          "properties": {"kind": {"const": "oma-access-token"}, "minimumScope": {"enum": ["read", "write", "admin"]}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "operationId"],
          "properties": {"kind": {"const": "oma-whoami-bootstrap"}, "operationId": {"const": "GET /api/cli/whoami"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "pathPrefix", "handlerOptIn"],
          "properties": {"kind": {"const": "mcp-connect"}, "pathPrefix": {"const": "/api/mcp/"}, "handlerOptIn": {"const": true}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "sourceScopes"],
          "properties": {"kind": {"const": "runtime-api-key"}, "sourceScopes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "sourceScopes"],
          "properties": {"kind": {"const": "metadata-api-key"}, "sourceScopes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "loopbackOnly"],
          "properties": {"kind": {"const": "trusted-local"}, "loopbackOnly": {"const": true}}
        }
      ]
    },
    "clientApiAuthorizationAlternative": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "sourceScopes"],
          "properties": {"kind": {"const": "runtime-api-key"}, "sourceScopes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "sourceScopes"],
          "properties": {"kind": {"const": "metadata-api-key"}, "sourceScopes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {"kind": {"const": "anonymous"}}
        }
      ]
    },
    "sourceAuthorizationPolicy": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {"status": {"const": "unknown"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "source", "routeClass", "localOnly", "handlerGuard", "bootstrap", "alternatives"],
          "properties": {
            "status": {"const": "qualified"},
            "source": {"const": "omniroute-v3.8.52"},
            "routeClass": {"const": "management"},
            "localOnly": {"type": "boolean"},
            "handlerGuard": {"enum": ["none", "requireManagementAuth"]},
            "bootstrap": {"enum": ["none", "oma-whoami"]},
            "alternatives": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/managementAuthorizationAlternative"}}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "source", "routeClass", "localOnly", "alternatives"],
          "properties": {
            "status": {"const": "qualified"},
            "source": {"const": "omniroute-v3.8.52"},
            "routeClass": {"const": "client-api"},
            "localOnly": {"type": "boolean"},
            "alternatives": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/clientApiAuthorizationAlternative"}}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "source", "routeClass", "alternatives"],
          "properties": {
            "status": {"const": "qualified"},
            "source": {"const": "omniroute-v3.8.52"},
            "routeClass": {"const": "public"},
            "alternatives": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind"],
                "properties": {"kind": {"const": "anonymous"}}
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "source", "routeClass", "localOnly", "alternatives"],
          "properties": {
            "status": {"const": "qualified"},
            "source": {"const": "omniroute-v3.8.52"},
            "routeClass": {"const": "local"},
            "localOnly": {"const": true},
            "alternatives": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
