{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cruxexperts.example/cruxomni-omp-client/contracts/release-eligibility.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "recordKind",
    "release",
    "default",
    "operations",
    "history"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 3
    },
    "recordKind": {
      "const": "omniroute-release-eligibility"
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "tag",
        "commit"
      ],
      "properties": {
        "repository": {
          "const": "diegosouzapw/OmniRoute"
        },
        "tag": {
          "const": "v3.8.52"
        },
        "commit": {
          "const": "ad6f33f66bda34eba98645d3bfdabbde294bc843"
        }
      }
    },
    "default": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason"
      ],
      "properties": {
        "status": {
          "const": "unavailable"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "operations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/operation"
      }
    },
    "history": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/historicalRelease"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "gitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "sha256",
        "gitBlobSha"
      ],
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "gitBlobSha": {
          "$ref": "#/$defs/gitSha"
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "detail"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "detail": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "operationContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request",
        "auth",
        "response",
        "secrets",
        "sideEffect",
        "pagination",
        "streaming",
        "confirmation",
        "retry",
        "reconciliation",
        "mutationSafety"
      ],
      "properties": {
        "request": {
          "$ref": "./operations.schema.json#/$defs/request"
        },
        "auth": {
          "$ref": "./operations.schema.json#/$defs/operation/properties/auth"
        },
        "response": {
          "$ref": "./operations.schema.json#/$defs/response"
        },
        "secrets": {
          "$ref": "./operations.schema.json#/$defs/operation/properties/secrets"
        },
        "sideEffect": {
          "$ref": "./operations.schema.json#/$defs/operation/properties/sideEffect"
        },
        "pagination": {
          "$ref": "./operations.schema.json#/$defs/operation/properties/pagination"
        },
        "streaming": {
          "$ref": "./operations.schema.json#/$defs/operation/properties/streaming"
        },
        "confirmation": {
          "$ref": "./operations.schema.json#/$defs/operation/properties/confirmation"
        },
        "retry": {
          "$ref": "./operations.schema.json#/$defs/operation/properties/retry"
        },
        "reconciliation": {
          "$ref": "./operations.schema.json#/$defs/reconciliation"
        },
        "mutationSafety": {
          "$ref": "./operations.schema.json#/$defs/mutationSafety"
        }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationId",
        "status",
        "reason",
        "source",
        "contract",
        "binding",
        "test",
        "evidence"
      ],
      "properties": {
        "operationId": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "const": "verified"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "contract": {
          "$ref": "#/$defs/operationContract"
        },
        "binding": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requestSchemaSha256",
            "authSha256",
            "sideEffect",
            "responseProjectionSha256",
            "operationSemanticsSha256",
            "routeImportsSha256",
            "frameworkContextSha256",
            "mutationSafetySha256"
          ],
          "properties": {
            "requestSchemaSha256": {
              "$ref": "#/$defs/sha256"
            },
            "authSha256": {
              "$ref": "#/$defs/sha256"
            },
            "sideEffect": {
              "enum": [
                "read",
                "mutation",
                "secret",
                "lifecycle",
                "destructive"
              ]
            },
            "responseProjectionSha256": {
              "$ref": "#/$defs/sha256"
            },
            "operationSemanticsSha256": {
              "$ref": "#/$defs/sha256"
            },
            "routeImportsSha256": {
              "$ref": "#/$defs/sha256"
            },
            "frameworkContextSha256": {
              "$ref": "#/$defs/sha256"
            },
            "mutationSafetySha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "test": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "observedOutcome",
            "caseSha256",
            "outcomeSha256"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^test/[^\\\\]+$"
            },
            "observedOutcome": {
              "type": "string",
              "pattern": "^provenance/qualification/[a-f0-9]{64}\\.json$"
            },
            "caseSha256": {
              "$ref": "#/$defs/sha256"
            },
            "outcomeSha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "historicalRelease": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release",
        "operations"
      ],
      "properties": {
        "release": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "tag",
            "commit"
          ],
          "properties": {
            "repository": {
              "const": "diegosouzapw/OmniRoute"
            },
            "tag": {
              "type": "string",
              "minLength": 1
            },
            "commit": {
              "$ref": "#/$defs/gitSha"
            }
          }
        },
        "operations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/historicalOperation"
          }
        }
      }
    },
    "historicalOperation": {
      "oneOf": [
        {
          "$ref": "#/$defs/legacyHistoricalOperation"
        },
        {
          "$ref": "#/$defs/archivedOperation"
        }
      ]
    },
    "legacyHistoricalOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationId",
        "status",
        "reason",
        "source",
        "evidence",
        "response"
      ],
      "properties": {
        "operationId": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "const": "verified"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "response": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "required",
            "properties"
          ],
          "properties": {
            "required": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "properties": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "const": "string"
                  },
                  "enum": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "format": {
                    "const": "date-time"
                  }
                }
              }
            }
          }
        }
      }
    },
    "archivedOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationId",
        "status",
        "reason",
        "source",
        "contract",
        "binding",
        "test",
        "evidence"
      ],
      "properties": {
        "operationId": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "const": "verified"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "contract": {
          "type": "object"
        },
        "binding": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requestSchemaSha256",
            "authSha256",
            "sideEffect",
            "responseProjectionSha256",
            "operationSemanticsSha256",
            "routeImportsSha256",
            "frameworkContextSha256",
            "mutationSafetySha256"
          ],
          "properties": {
            "requestSchemaSha256": {
              "$ref": "#/$defs/sha256"
            },
            "authSha256": {
              "$ref": "#/$defs/sha256"
            },
            "sideEffect": {
              "enum": [
                "read",
                "mutation",
                "secret",
                "lifecycle",
                "destructive"
              ]
            },
            "responseProjectionSha256": {
              "$ref": "#/$defs/sha256"
            },
            "operationSemanticsSha256": {
              "$ref": "#/$defs/sha256"
            },
            "routeImportsSha256": {
              "$ref": "#/$defs/sha256"
            },
            "frameworkContextSha256": {
              "$ref": "#/$defs/sha256"
            },
            "mutationSafetySha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "test": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "observedOutcome",
            "caseSha256",
            "outcomeSha256"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^test/[^\\\\]+$"
            },
            "observedOutcome": {
              "type": "string",
              "pattern": "^(?:provenance/qualification|\\.agents/state/omp-provider-release/qualification-observations)/[a-f0-9]{64}\\.json$"
            },
            "caseSha256": {
              "$ref": "#/$defs/sha256"
            },
            "outcomeSha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    }
  }
}
