{
  "name": "@cruxexperts/cruxomni-omp-client",
  "version": "1.0.3",
  "description": "OMP OmniRoute Provider for Oh My Pi with guided setup, live discovery, and verified administration",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CruxExperts/OMP-OmniRoute-Provider.git"
  },
  "homepage": "https://github.com/CruxExperts/OMP-OmniRoute-Provider#readme",
  "bugs": {
    "url": "https://github.com/CruxExperts/OMP-OmniRoute-Provider/issues"
  },
  "keywords": [
    "omp",
    "oh-my-pi",
    "omniroute",
    "cruxexperts",
    "model-provider"
  ],
  "license": "MIT",
  "author": "Crux Experts LLC",
  "copyright": "Copyright (c) 2026 Crux Experts LLC",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "contracts",
    "provenance",
    "scripts",
    "test/fixtures",
    "assets",
    "docs",
    ".omp-plugin",
    "README.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "ASSET_LICENSE.md",
    "THIRD_PARTY_NOTICES.md",
    "VERSION",
    "LICENSE",
    "SUPPORT.md"
  ],
  "omp": {
    "name": "OMP OmniRoute Provider",
    "settings": {
      "showSetupInvitation": {
        "type": "boolean",
        "default": true,
        "description": "Offer guided setup once for an unconfigured interactive profile"
      },
      "notifyTransitions": {
        "type": "boolean",
        "default": true,
        "description": "Show provider connection state transitions"
      }
    },
    "extensions": [
      "./src/index.ts"
    ],
    "compatibility": {
      "host": ">=18.12.2 <19",
      "tested": [
        "18.12.2",
        "18.12.5",
        "18.12.6"
      ]
    }
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2"
  },
  "peerDependencies": {
    "@oh-my-pi/pi-ai": ">=18.12.2 <19",
    "@oh-my-pi/pi-catalog": ">=18.12.2 <19",
    "@oh-my-pi/pi-coding-agent": ">=18.12.2 <19",
    "@oh-my-pi/pi-tui": ">=18.12.2 <19",
    "@oh-my-pi/pi-utils": ">=18.12.2 <19"
  },
  "peerDependenciesMeta": {
    "@oh-my-pi/pi-ai": {
      "optional": true
    },
    "@oh-my-pi/pi-catalog": {
      "optional": true
    },
    "@oh-my-pi/pi-coding-agent": {
      "optional": true
    },
    "@oh-my-pi/pi-tui": {
      "optional": true
    },
    "@oh-my-pi/pi-utils": {
      "optional": true
    }
  },
  "devDependencies": {
    "@oh-my-pi/pi-ai": "18.12.5",
    "@oh-my-pi/pi-catalog": "18.12.5",
    "@oh-my-pi/pi-coding-agent": "18.12.5",
    "@oh-my-pi/pi-tui": "18.12.5",
    "@oh-my-pi/pi-utils": "18.12.5",
    "@types/bun": "1.4.2",
    "@types/node": "22.15.0",
    "typescript": "5.8.3",
    "zod": "4.6.7"
  },
  "scripts": {
    "version:check": "bun run scripts/version.ts check",
    "version:plan": "bun run scripts/version.ts plan",
    "version:set": "bun run scripts/version.ts set",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "verify:contracts": "bun run scripts/verify-contracts.ts",
    "verify:package": "bun run scripts/verify-package.ts",
    "verify:marketplace": "bun run scripts/verify-marketplace.ts",
    "export:release": "bun run scripts/export-release.ts",
    "smoke": "bun run scripts/smoke.ts",
    "smoke:installed": "OMP_SMOKE_HOST_MODE=installed-cli bun run scripts/smoke.ts",
    "check:upstreams": "bun run scripts/check-upstreams.ts",
    "docs:generate": "bun run scripts/generate-docs.ts",
    "docs:check": "bun run scripts/generate-docs.ts --check",
    "hooks:install": "git config --local core.hooksPath .githooks",
    "prepare:upstream": "python3 scripts/prepare-upstream.py",
    "verify:qualification": "bun run scripts/verify-qualification.ts"
  }
}
