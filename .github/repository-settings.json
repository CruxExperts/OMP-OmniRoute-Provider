{
  "status": "configured 2026-10-23; execution evidence in docs/reference/maintenance.md",
  "repository": "CruxExperts/OMP-OmniRoute-Provider",
  "description": "Connect Oh My Pi to your existing OmniRoute gateway. Guided setup, live model discovery, and optional reviewed administration.",
  "topics": [
    "ai",
    "ai-gateway",
    "bun",
    "cli",
    "coding-assistant",
    "cruxexperts",
    "developer-tools",
    "llm",
    "model-provider",
    "oh-my-pi",
    "omniroute",
    "omp",
    "open-source",
    "openai-compatible",
    "plugin",
    "typescript"
  ],
  "socialPreview": "assets/brand/marketing/social-preview.png",
  "rulesets": [
    {
      "name": "Copilot review",
      "target": "branch",
      "enforcement": "active",
      "conditions": {
        "ref_name": {
          "include": [
            "~DEFAULT_BRANCH"
          ],
          "exclude": []
        }
      },
      "rules": [
        {
          "type": "copilot_code_review",
          "parameters": {
            "review_draft_pull_requests": false,
            "review_on_push": true
          }
        }
      ],
      "bypass_actors": []
    }
  ],
  "maintenance": {
    "variable": "CRUXOMNI_MAINTENANCE_ENABLED",
    "enabledAfterReview": "true",
    "dailyUtc": "07:17",
    "backlog": ".github/1.0.0-backlog.json",
    "issueLabels": [
      "maintenance",
      "automation"
    ],
    "enabled": true
  },
  "activationRequirements": [
    "Verify maintenance dispatch creates bot-owned findings and a repeated dispatch does not duplicate issues",
    "Verify Copilot setup workflow on GitHub",
    "Verify native Copilot assignment produces an agent session or PR",
    "Verify actual social preview separately; file presence does not prove selected pixels"
  ],
  "branchProtection": {
    "branch": "main",
    "requiredSignatures": true,
    "strictRequiredStatusChecks": true,
    "requiredStatusChecks": [
      "package",
      "host-smoke (18.12.2)",
      "host-smoke (18.12.5)"
    ],
    "requireIndependentHumanApproval": false,
    "reason": "Retain existing review policy; no independent human reviewer has been verified."
  },
  "actions": {
    "default_workflow_permissions": "read",
    "can_approve_pull_request_reviews": false,
    "sha_pinning_required": true
  },
  "copilotSetup": ".github/workflows/copilot-setup-steps.yml"
}
